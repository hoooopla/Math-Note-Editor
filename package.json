{
  "name": "math-note-editor",
  "productName": "Math Note Editor",
  "description": "A local-first, block-based mathematical note editor.",
  "author": "Math Note Editor contributors",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:test": "tsx server.ts --test-mode",
    "test:e2e": "playwright test",
    "test:atomic-saves": "tsx --test scripts/atomic-file.test.ts",
    "test:desktop-server": "node scripts/smoke-desktop-server.mjs",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --external:vite --outfile=desktop-server/server.cjs",
    "build:desktop": "npm run build && npm run build:server",
    "desktop:dev": "npm run build:desktop && electron .",
    "desktop:pack": "npm run build:desktop && electron-builder --dir",
    "desktop:dist": "npm run build:desktop && electron-builder",
    "preview": "vite preview",
    "start": "node server.ts --production",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-virtual": "^3.14.6",
    "@types/lodash": "^4.17.24",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "codemirror-lang-latex": "^0.4.1",
    "esbuild": "^0.28.1",
    "express": "^4.21.2",
    "katex": "^0.16.45",
    "lodash": "^4.18.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-force-graph-2d": "^1.29.1",
    "tailwind-merge": "^3.5.0",
    "uuid": "^13.0.0",
    "vite": "^6.2.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.61.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.mathnotes.editor",
    "productName": "Math Note Editor",
    "directories": {
      "output": "release"
    },
    "icon": "public/pwa-512x512.png",
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "dist", "to": "web" },
      { "from": "desktop-server", "to": "desktop-server" }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "linux": {
      "category": "Office",
      "target": ["AppImage"]
    }
  },
  "overrides": {
    "node-domexception": "file:./packages/node-domexception"
  }
}
